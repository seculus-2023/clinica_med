# ===== MedAccess - configuracao do ambiente =====
# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Ex.: https://clinica.seudominio.com.br (necessario em producao com HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados
# DB_ENGINE: postgresql (padrao), sqlite ou mysql
DB_ENGINE=postgresql
# Nome do banco no PostgreSQL (criado pelo configurar_postgres.bat)
DB_NAME=clinicamedica
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432


# URL publica usada nos links de confirmacao enviados por WhatsApp/e-mail
SITE_URL=http://localhost:8000

# E-mail (SMTP). Com o backend "console" os e-mails aparecem no terminal.
# Para envio real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=arpjunior40@gmail.com
EMAIL_HOST_PASSWORD=fltmyxzaeeymdphp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clinica <nao-responda@clinica.com.br>


# Lembretes automaticos (processados a cada N minutos durante o uso do sistema)
AUTO_LEMBRETES=1
AUTO_LEMBRETES_INTERVALO_MIN=10
NOTIFICACOES_ASSINCRONAS=1

# Obs.: as credenciais do WhatsApp (provedor, token, instancia) sao configuradas
# por clinica em Administrativo > Configuracoes da clinica.
