# ===== MedAccess - .env do SERVIDOR (producao, atras do Caddy/HTTPS) =====
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-unica
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=clinica.arpjr.com.br,24.152.36.103,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://clinica.arpjr.com.br,https://24.152.36.103:8003
# O Caddy faz o HTTPS; o Django recebe HTTP interno e nao deve redirecionar.
SECURE_SSL_REDIRECT=0

# Banco de dados
# DB_ENGINE: postgresql (padrao), sqlite ou mysql
DB_ENGINE=postgresql
# Nome do banco no PostgreSQL (criado pelo configurar_postgres.bat)
DB_NAME=clinicamedica
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432


# Endereco publico usado nos links enviados aos pacientes (WhatsApp, SMS, e-mail)
SITE_URL=https://clinica.arpjr.com.br

# E-mail (SMTP). Com o backend "console" os e-mails aparecem no terminal.
# Para envio real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=arpjunior40@gmail.com
EMAIL_HOST_PASSWORD=fltmyxzaeeymdphp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clinica <nao-responda@clinica.com.br>

AUTO_LEMBRETES=1
AUTO_LEMBRETES_INTERVALO_MIN=10
NOTIFICACOES_ASSINCRONAS=1

# Venda do sistema para outras clínicas (SaaS)
SAAS_ATIVO=0
SAAS_CADASTRO_ABERTO=0
SAAS_NOME=MedAccess
SAAS_PIX_CHAVE=
SAAS_PIX_NOME=
SAAS_PIX_CIDADE=
