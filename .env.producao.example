# ===== MedAccess - .env do SERVIDOR (producao, atras do Caddy/HTTPS) =====
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-unica
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=clinica.arpjr.com.br,24.152.36.103,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://clinica.arpjr.com.br,https://24.152.36.103:8003
# O Caddy faz o HTTPS; o Django recebe HTTP interno e nao deve redirecionar.
SECURE_SSL_REDIRECT=0

# Banco de dados
# DB_ENGINE: sqlite (arquivo local, padrao), postgresql ou mysql
DB_ENGINE=sqlite
# Recomendado para producao com varios usuarios: DB_ENGINE=postgresql (pip install psycopg[binary])
# sqlite: nome do arquivo (relativo a pasta do projeto ou caminho completo)
DB_NAME=db.sqlite3
# postgresql / mysql (ignorados no sqlite):
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# Endereco publico usado nos links enviados aos pacientes (WhatsApp, SMS, e-mail)
SITE_URL=https://clinica.arpjr.com.br

# E-mail (pode tambem ser configurado por clinica no sistema)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MedAccess <nao-responda@arpjr.com.br>

AUTO_LEMBRETES=1
AUTO_LEMBRETES_INTERVALO_MIN=10
NOTIFICACOES_ASSINCRONAS=1
